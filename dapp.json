{
  "icon": {
    "image": "brand/icon.png"
  },
  "name": "Awas Ada Pocong",
  "description": "Hide from the Pocong in a haunted mansion and score by surviving.",
  "secrets": [],
  "visibility": {
    "build": "private",
    "view": "public"
  },
  "tests": [
    {
      "name": "Start poster is shown with the four shortcuts",
      "path": "/",
      "expectSelector": "#start-poster #start-play"
    },
    {
      "name": "Start poster artwork is wired to the asset path",
      "path": "/",
      "expectSelector": "#start-poster #start-poster-art"
    },
    {
      "name": "Play Game offers the three difficulties",
      "path": "/",
      "expectSelector": "#difficulty-step #diff-diehard"
    },
    {
      "name": "Settings sheet has the sound slider and the disabled ghost chooser",
      "path": "/",
      "expectSelector": "#settings-sheet:has(#sound-slider):has(#ghost-raminom[disabled])"
    },
    {
      "name": "Winner history shows a difficulty and a ghost per row",
      "path": "/",
      "expectSelector": "#leaderboard-list li:first-child .lb-streak"
    },
    {
      "id": "start.wallet-card",
      "name": "Wallet card lists the three tokens with Swap and Withdraw",
      "path": "/",
      "expectSelector": "#wallet-card .wallet-row:nth-child(3) #wallet-withdraw-tkn",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "name": "Winner history API returns winners",
      "path": "/api/game/leaderboard",
      "expectText": "\"winners\""
    },
    {
      "name": "Run state API answers",
      "path": "/api/game/run/state",
      "expectText": "difficulty_options"
    },
    {
      "name": "Settings API answers",
      "path": "/api/settings",
      "expectText": "\"sound_volume\""
    },
    {
      "name": "Game loads with no errors",
      "path": "/",
      "expectSelector": "#title"
    },
    {
      "id": "game.hiding-phase",
      "name": "Hiding phase shows the countdown, the map and the controls",
      "path": "/",
      "expectSelector": "#hiding-timer",
      "expectText": "Hiding Phase:",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "name": "Blueprint map renders with its title and the eleven room buttons",
      "path": "/",
      "expectSelector": "#room-grid button:nth-child(11)",
      "expectText": "Mansion Level 1 Hallway Map"
    },
    {
      "name": "Side panel shows Player Setup, the signature box and the daring pick",
      "path": "/",
      "expectSelector": "#sig-initials",
      "expectText": "Player Setup: Select & Confirm"
    },
    {
      "name": "Daring second pick step is on the panel",
      "path": "/",
      "expectSelector": "#btn-daring",
      "expectText": "Daring Pick"
    },
    {
      "name": "Mute toggle is present",
      "path": "/",
      "expectSelector": "#btn-mute"
    },
    {
      "name": "Pocong Route is drawn on the map",
      "path": "/",
      "expectText": "Pocong Route"
    },
    {
      "name": "Game state API returns round data",
      "path": "/api/game/state",
      "expectText": "round"
    },
    {
      "name": "A hiding round auto-opens from a legacy round, with its end timestamp",
      "path": "/api/game/state",
      "expectText": "\"status\":\"hiding\",\"target_room\":null,\"hiding_ends_at\":\"20"
    },
    {
      "name": "Leaderboard API returns winner history",
      "path": "/api/game/leaderboard",
      "expectText": "leaderboard"
    },
    {
      "name": "Game Mode switch offers the open round and Party",
      "path": "/",
      "expectSelector": "#mode-party",
      "expectText": "Game Mode"
    },
    {
      "id": "party.demo-scoreboard",
      "name": "Party screen shows the party code and its scoreboard",
      "path": "/?party=DEMO1",
      "expectSelector": "#party-scoreboard li:nth-child(4)",
      "expectText": "Party code: DEMO1",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "name": "Party state API returns the party, its members and its round",
      "path": "/api/party/DEMO1/state",
      "expectText": "\"code\":\"DEMO1\""
    },
    {
      "name": "Pocong app icon is served for the favicon",
      "path": "/icon.svg",
      "expectSelector": "clipPath#bodyClip"
    },
    {
      "id": "wallet.gate",
      "name": "Wallet bind gate is on the page",
      "path": "/",
      "expectSelector": "#wallet-gate #btn-bind",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "name": "Wallet sheet has the bind control",
      "path": "/",
      "expectSelector": "#wallet-bind #wallet-bind-btn"
    },
    {
      "id": "wallet.bind-panel",
      "name": "Wallet sheet shows the bind address and live balance panel",
      "path": "/",
      "expectSelector": "#wallet-bind #wallet-bind-bal",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "Wallet status API answers (signed out here)",
      "path": "/api/wallet/me",
      "expectText": "linked_wallet"
    }
  ],
  "governance": {
    "approvers": "invited",
    "approvals": "default"
  }
}
